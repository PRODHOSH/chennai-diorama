# ---------------------------------------------------------------
# Namma Chennai — environment
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# Then restart `npm run dev`.
# ---------------------------------------------------------------

# Your Cloudinary cloud name (Dashboard → top-left, "Cloud name").
VITE_CLOUDINARY_CLOUD_NAME=

# An UNSIGNED upload preset (Settings → Upload → Upload presets → Add,
# set "Signing mode" to Unsigned). Visitors' photos/videos upload with it.
VITE_CLOUDINARY_UPLOAD_PRESET=

# Folder uploads land in. Optional; defaults to "namma-chennai".
VITE_CLOUDINARY_FOLDER=namma-chennai

# Do NOT put your API key or API secret here. Anything starting with VITE_
# is bundled into the browser code, where anyone can read it. This app only
# needs the cloud name and an unsigned preset.
